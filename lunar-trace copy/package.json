{
  "name": "lunartrace",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:site": "MOON_DEV_AUTOSTART=0 vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-moon.mjs",
    "build:site": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:moon": "cd moon-explorer && npm test",
    "moon:install": "cd moon-explorer && npm install"
  },
  "dependencies": {
    "three": "^0.187.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/node": "^22.0.0"
  }
}
